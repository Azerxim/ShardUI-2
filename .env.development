# Surcharge de .env pour `vite` (mode développement) — valeurs locales uniquement.
# Éditeur de carte ShardUI-2-Maps lancé par `npm run maps:dev`.
VITE_MAPS_BASE_URL=http://localhost:3005

# Vide : le frontend appelle /api sur l'origine de Vite, relayé vers Shard-API par le proxy
# de vite.config.js (fonctionne aussi en VS Code Remote SSH, où seul le port de Vite est redirigé).
VITE_API_BASE_URL=
# Adresse de Shard-API lancée par `npm run dev` (lue par vite.config.js, non exposée au navigateur).
API_PROXY_TARGET=http://127.0.0.1:8002
