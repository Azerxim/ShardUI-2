# Modèle de .env pour ShardUI-2 : copier en .env et remplir.
# Les variables VITE_* sont lues au build et exposées au navigateur : n'y mettre aucun secret.
# En développement, .env.development surcharge ces valeurs (voir ce fichier).

# Adresse du serveur Minecraft affichée et copiée depuis l'accueil (pages/home/HomePage.jsx).
# Exemple : play.tetrago.fr
VITE_SERVER_URL=

# Origine de Shard-API, sans /api ni barre finale (services/api.js y ajoute /api).
# Vide : appels relatifs à /api sur l'origine du site (proxy de vite.config.js en développement).
# Exemple : https://tetrago.fr
VITE_API_BASE_URL=

# Adresse de ShardUI-2-Maps (cartes intégrées, liens et éditeur de carte), voir src/config/maps.js.
# Vide : repli sur https://map.tetrago.fr
VITE_MAPS_BASE_URL=

# Vide, une date ISO (compte à rebours) ou "prochainement" : voir src/config/saison.js
# Exemple : 2026-11-14T14:00:00+01:00 (heure d'hiver à Paris ; +02:00 en été)
VITE_SAISON_LANCEMENT=

# Statut des serveurs Minecraft affiché dans la barre de navigation (components/layout/Navbar.jsx).
# URL de l'API de statut, terminée par ip= : chaque adresse ci-dessous y est collée telle quelle.
VITE_MC_API=https://mcapi.us/server/status?ip=
# Adresse du proxy (réseau) dont on affiche l'état.
VITE_MC_PROXY=
# Adresse du serveur de jeu Tetrago dont on affiche l'état.
VITE_MC_SERVER=

# Développement uniquement : cible du proxy /api de vite.config.js (non exposée au navigateur).
# Par défaut http://127.0.0.1:8002 ; .env.development la fixe à 8001.
# API_PROXY_TARGET=http://127.0.0.1:8001
